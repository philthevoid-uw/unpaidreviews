{
  // Same Worker that already serves unpaidreviews.com. Custom domains are attached in the
  // Cloudflare dashboard, not here, so a deploy can never fail because of DNS state.
  "name": "unpaidreviews",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "workers_dev": false,
  "preview_urls": false
}
